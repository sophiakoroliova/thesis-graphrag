la:Dimension a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:DimensionAndRankTopic ;
    edu:notation "dim H" ;
    edu:requires la:Basis ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 2.9, p. 157" ;
    skos:definition "The number of vectors in any basis of a nonzero subspace; the zero subspace has dimension zero."@en ;
