    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 1.4" ;
    skos:prefLabel "The Matrix Equation Ax = b"@en .

la:VectorSum a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:VectorEquationsTopic ;
    edu:notation "u + v" ;
    edu:requires la:Vector ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 1.3, p. 25" ;
    skos:definition "The vector obtained by adding corresponding entries of two vectors of the same size."@en ;
