    skos:definition "The vector (or matrix) obtained by multiplying every entry by a scalar."@en ;
    skos:hiddenLabel "scalar multiples"@en ;
    skos:prefLabel "scalar multiple"@en .

la:SolutionSetsOfLinearSystemsTopic a edu:Topic,
