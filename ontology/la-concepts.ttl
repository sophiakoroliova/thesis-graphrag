    skos:definition "A set {v1, ..., vp} such that H = Span{v1, ..., vp}."@en ;
    skos:prefLabel "spanning set"@en .

la:TheMatrixOfALinearTransformationTopic a edu:Topic,
        owl:NamedIndividual ;
    edu:order 8 ;
    edu:partOf la:LinearEquationsModule ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 1.9" ;
    skos:prefLabel "The Matrix of a Linear Transformation"@en .

la:Transpose a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:MatrixOperationsTopic ;
    edu:notation "A^T",
        "Aᵀ" ;
    edu:requires la:Matrix ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 2.1, p. 101" ;
    skos:altLabel "transpose"@en ;
    skos:definition "The matrix whose columns are the corresponding rows of A."@en ;
    skos:prefLabel "transpose of a matrix"@en .

la:TrivialSolution a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:SolutionSetsOfLinearSystemsTopic ;
    edu:requires la:HomogeneousSystem ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 1.5, p. 44" ;
    skos:definition "The zero solution x = 0 of a homogeneous system."@en ;
    skos:prefLabel "trivial solution"@en .

la:ZeroVector a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:VectorEquationsTopic ;
    edu:notation "0" ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 1.3, p. 27" ;
    skos:broader la:Vector ;
    skos:definition "The vector whose entries are all zero."@en ;
    skos:prefLabel "zero vector"@en .

la:CharacteristicEquation a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:TheCharacteristicEquationTopic ;
    edu:notation "det(A − λI) = 0" ;
    edu:requires la:Determinant,
        la:Eigenvalue ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 5.2, p. 278" ;
    skos:definition "The equation det(A − λI) = 0, whose roots are the eigenvalues of A."@en ;
    skos:prefLabel "characteristic equation"@en .

la:CoordinateSystemsTopic a edu:Topic,
        owl:NamedIndividual ;
    edu:order 22 ;
    edu:partOf la:VectorSpacesModule ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 4.4" ;
    skos:prefLabel "Coordinate Systems"@en .

la:CoordinateVector a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:DimensionAndRankTopic ;
    edu:notation "[x]_B" ;
    edu:requires la:Basis ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 2.9, p. 156" ;
    skos:altLabel "B-coordinate vector"@en ;
    skos:definition "The vector of weights [x]B = (c1, ..., cp) such that x = c1b1 + ... + cpbp for a basis B."@en ;
    skos:hiddenLabel "coordinates relative to a basis"@en ;
    skos:prefLabel "coordinate vector"@en .

la:DiagonalizationTopic a edu:Topic,
        owl:NamedIndividual ;
    edu:order 28 ;
    edu:partOf la:EigenvaluesModule ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 5.3" ;
    skos:prefLabel "Diagonalization"@en .

la:EchelonForm a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:RowReductionAndEchelonFormsTopic ;
    edu:requires la:LeadingEntry ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 1.2, p. 13" ;
    skos:altLabel "echelon matrix"@en,
        "row echelon form"@en ;
    skos:broader la:Matrix ;
    skos:definition "A matrix form in which nonzero rows are above zero rows and each leading entry lies to the right of the leading entry above it."@en ;
    skos:prefLabel "echelon form"@en .

la:Eigenvector a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:EigenvectorsAndEigenvaluesTopic ;
    edu:requires la:MatrixVectorProduct,
        la:SquareMatrix ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 5.1, p. 269" ;
    skos:definition "A nonzero vector x such that Ax = λx for some scalar λ, where A is a square matrix."@en ;
    skos:hiddenLabel "eigenvectors"@en ;
    skos:prefLabel "eigenvector"@en .

la:IntroductionToLinearTransformationsTopic a edu:Topic,
        owl:NamedIndividual ;
    edu:order 7 ;
    edu:partOf la:LinearEquationsModule ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 1.8" ;
    skos:prefLabel "Introduction to Linear Transformations"@en .

la:LinearIndependenceTopic a edu:Topic,
        owl:NamedIndividual ;
    edu:order 6 ;
    edu:partOf la:LinearEquationsModule ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 1.7" ;
    skos:prefLabel "Linear Independence"@en .

la:MatrixEquation a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:TheMatrixEquationAxBTopic ;
    edu:notation "Ax = b" ;
    edu:requires la:MatrixVectorProduct,
        la:VectorEquation ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 1.4, p. 36" ;
    skos:definition "An equation of the form Ax = b; it is equivalent to the corresponding vector equation and linear system."@en ;
    skos:prefLabel "matrix equation"@en .

la:NullSpace a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:SubspacesOfRnTopic ;
    edu:notation "Nul A" ;
    edu:requires la:HomogeneousSystem ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 2.8, p. 150" ;
    skos:altLabel "null space"@en ;
    skos:broader la:Subspace ;
    skos:definition "The set of all solutions of the homogeneous equation Ax = 0."@en ;
    skos:hiddenLabel "null-space"@en ;
    skos:prefLabel "null space of a matrix"@en .

la:PivotColumn a edu:Concept,
