la:ElementaryRowOperation a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:SystemsOfLinearEquationsTopic ;
    edu:requires la:Matrix ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 1.1, p. 6" ;
    skos:definition "Replacement, interchange or scaling of rows of a matrix."@en ;
    skos:hiddenLabel "elementary row operations"@en ;
