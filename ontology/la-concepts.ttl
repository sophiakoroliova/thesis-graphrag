la:IdentityMatrix a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:TheMatrixEquationAxBTopic ;
    edu:notation "I",
        "Iₙ" ;
    edu:requires la:Matrix ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 1.4, p. 39" ;
    skos:broader la:DiagonalMatrix ;
    skos:definition "The square matrix with ones on the main diagonal and zeros elsewhere; Ix = x for every x."@en ;
    skos:prefLabel "identity matrix"@en .

la:InverseOfMatrix a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:TheInverseOfAMatrixTopic ;
    edu:notation "A^{-1}",
        "A⁻¹" ;
    edu:requires la:InvertibleMatrix ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 2.2, p. 105" ;
    skos:altLabel "matrix inverse"@en ;
    skos:definition "The unique matrix A⁻¹ with A⁻¹A = I and AA⁻¹ = I for an invertible matrix A."@en ;
    skos:prefLabel "inverse of a matrix"@en .

la:LinearAlgebraCourse a edu:Course,
        owl:NamedIndividual ;
    skos:prefLabel "Linear Algebra"@en .

la:LinearTransformation a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:IntroductionToLinearTransformationsTopic ;
    edu:requires la:ScalarMultiple,
        la:VectorSum ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 1.8, p. 66" ;
    skos:broader la:Transformation ;
    skos:definition "A transformation T with T(u + v) = T(u) + T(v) and T(cu) = cT(u) for all vectors u, v and scalars c."@en ;
    skos:hiddenLabel "linear transformations"@en ;
    skos:prefLabel "linear transformation"@en .

la:SubspacesOfRnTopic a edu:Topic,
        owl:NamedIndividual ;
    edu:order 14 ;
    edu:partOf la:MatrixAlgebraModule ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 2.8" ;
    skos:prefLabel "Subspaces of Rn"@en .

la:SystemOfLinearEquations a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:SystemsOfLinearEquationsTopic ;
    edu:requires la:LinearEquation ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 1.1, p. 2" ;
    skos:altLabel "linear system"@en ;
    skos:definition "A collection of one or more linear equations in the same variables."@en ;
    skos:hiddenLabel "systems of linear equations"@en ;
    skos:prefLabel "system of linear equations"@en .

la:TheInverseOfAMatrixTopic a edu:Topic,
        owl:NamedIndividual ;
    edu:order 10 ;
    edu:partOf la:MatrixAlgebraModule ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 2.2" ;
    skos:prefLabel "The Inverse of a Matrix"@en .

la:Transformation a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:IntroductionToLinearTransformationsTopic ;
    edu:notation "T: Rⁿ → Rᵐ" ;
    edu:requires la:Vector ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 1.8, p. 64" ;
    skos:altLabel "mapping"@en ;
    skos:definition "A rule T: Rn -> Rm that assigns to each vector x of the domain a vector T(x), its image, in the codomain."@en ;
    skos:editorialNote "The glossary of [Lay 2016] gives 'mapping: See transformation'."@en ;
    skos:hiddenLabel "transformations"@en ;
    skos:prefLabel "transformation"@en .

la:Vector a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:VectorEquationsTopic ;
    edu:notation "Rⁿ" ;
    edu:requires la:Matrix ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 1.3, p. 24" ;
    skos:altLabel "column vector"@en ;
    skos:definition "A matrix with only one column, i.e. an ordered list of n numbers, an element of Rn."@en ;
    skos:hiddenLabel "vectors"@en ;
    skos:prefLabel "vector"@en .

la:VectorSpace a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:VectorSpacesAndSubspacesTopic ;
    edu:notation "V" ;
    edu:requires la:ScalarMultiple,
        la:VectorSum,
        la:ZeroVector ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 4.1, p. 192" ;
    skos:definition "A nonempty set of objects with addition and scalar multiplication that satisfy the ten vector space axioms."@en ;
    skos:hiddenLabel "vector spaces"@en ;
    skos:prefLabel "vector space"@en .

la:InvertibleMatrix a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:TheInverseOfAMatrixTopic ;
    edu:requires la:IdentityMatrix,
        la:MatrixMultiplication ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 2.2, p. 105" ;
    skos:altLabel "nonsingular matrix"@en ;
    skos:broader la:SquareMatrix ;
    skos:definition "An n x n matrix A for which there is an n x n matrix C with CA = I and AC = I."@en ;
    skos:prefLabel "invertible matrix"@en .

la:LinearIndependence a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:LinearIndependenceTopic ;
    edu:requires la:TrivialSolution ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 1.7, p. 57" ;
    skos:altLabel "linearly independent set"@en ;
    skos:definition "A set {v1, ..., vp} is linearly independent if the equation x1v1 + ... + xpvp = 0 has only the trivial solution."@en ;
    skos:hiddenLabel "linearly independent"@en ;
    skos:prefLabel "linear independence"@en .

la:MatrixVectorProduct a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:TheMatrixEquationAxBTopic ;
    edu:notation "Ax" ;
    edu:requires la:LinearCombination ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 1.4, p. 35" ;
    skos:altLabel "product of a matrix and a vector"@en ;
    skos:definition "The product Ax of an m x n matrix A and a vector x in Rn: the linear combination of the columns of A with the entries of x as weights."@en ;
    skos:prefLabel "matrix-vector product"@en .

la:Subspace a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:SubspacesOfRnTopic ;
    edu:requires la:ScalarMultiple,
        la:VectorSum,
        la:ZeroVector ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 2.8, p. 148" ;
    skos:broader la:VectorSpace ;
    skos:definition "A set H that contains the zero vector and is closed under vector addition and scalar multiplication."@en ;
    skos:editorialNote "Introduced for Rn in 2.8 and for general vector spaces in 4.1."@en ;
    skos:hiddenLabel "subspaces"@en ;
    skos:prefLabel "subspace"@en .

la:LinearCombination a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:VectorEquationsTopic ;
    edu:requires la:ScalarMultiple,
        la:VectorSum ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 1.3, p. 28" ;
    skos:definition "A vector c1v1 + ... + cpvp formed from vectors v1, ..., vp with scalar weights c1, ..., cp."@en ;
    skos:hiddenLabel "linear combinations"@en ;
    skos:prefLabel "linear combination"@en .

la:MatrixAlgebraModule a edu:Module,
        owl:NamedIndividual ;
    edu:order 2 ;
    edu:partOf la:LinearAlgebraCourse ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, chapter 2" ;
