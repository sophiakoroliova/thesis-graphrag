@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edu: <http://example.org/edu#> .
@prefix la: <http://example.org/la#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/la> a owl:Ontology ;
    rdfs:label "Linear Algebra course ontology"@en ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016" ;
    owl:imports <http://example.org/edu> ;
    owl:versionInfo "1.0" .

la:AlgebraicMultiplicity a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:TheCharacteristicEquationTopic ;
    edu:requires la:CharacteristicPolynomial ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 5.2, p. 278" ;
    skos:altLabel "multiplicity of an eigenvalue"@en ;
    skos:definition "The multiplicity of an eigenvalue as a root of the characteristic equation."@en ;
    skos:prefLabel "algebraic multiplicity"@en .

la:BasisTheorem a edu:Theorem,
        owl:NamedIndividual ;
    edu:belongsToTopic la:DimensionAndRankTopic ;
    edu:requires la:Dimension ;
    edu:uses la:Basis,
        la:Dimension,
        la:LinearIndependence,
        la:Span ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 2.9, p. 158" ;
    skos:definition "In a p-dimensional space, any linearly independent set of exactly p elements and any spanning set of exactly p elements is a basis."@en ;
    skos:editorialNote "Stated for subspaces of Rn in 2.9 and for vector spaces in 4.5."@en ;
    skos:prefLabel "Basis Theorem"@en .

la:ChangeOfCoordinatesMatrixBtoC a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:ChangeOfBasisTopic ;
    edu:notation "P_{C←B}" ;
    edu:requires la:CoordinateVector ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 4.7, p. 242" ;
    skos:broader la:ChangeOfCoordinatesMatrix ;
    skos:definition "The matrix whose columns are the C-coordinate vectors of the vectors of basis B; it satisfies [x]C = P[x]B."@en ;
    skos:prefLabel "change-of-coordinates matrix from B to C"@en .

la:CharacterizationOfLinearlyDependentSets a edu:Theorem,
        owl:NamedIndividual ;
    edu:belongsToTopic la:LinearIndependenceTopic ;
    edu:requires la:LinearDependence ;
    edu:uses la:LinearCombination,
        la:LinearDependence ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 1.7, p. 59" ;
    skos:definition "A set of two or more vectors is linearly dependent iff at least one of the vectors is a linear combination of the others."@en ;
    skos:prefLabel "characterization of linearly dependent sets"@en .

la:CofactorExpansion a edu:Method,
        owl:NamedIndividual ;
    edu:belongsToTopic la:IntroductionToDeterminantsTopic ;
    edu:requires la:Cofactor ;
    edu:uses la:Cofactor,
        la:Determinant ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 3.1, p. 168" ;
    skos:altLabel "expansion by cofactors"@en ;
    skos:definition "Computing det A as the sum of the entries of a row (or column) multiplied by their cofactors."@en ;
    skos:editorialNote "Stated in [Lay 2016] as Theorem 1 in 3.1; classified as a method because it is used as a computing procedure."@en ;
    skos:prefLabel "cofactor expansion"@en .

la:ColumnRowExpansion a edu:Theorem,
        owl:NamedIndividual ;
    edu:belongsToTopic la:PartitionedMatricesTopic ;
    edu:requires la:MatrixMultiplication,
        la:PartitionedMatrix ;
    edu:uses la:MatrixMultiplication,
        la:PartitionedMatrix ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 2.4, p. 121" ;
    skos:definition "AB equals the sum of the products of the columns of A and the corresponding rows of B."@en ;
    skos:prefLabel "column-row expansion of AB"@en .

la:ComplexEigenvector a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:ComplexEigenvaluesTopic ;
    edu:requires la:ComplexEigenvalue ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 5.5, p. 298" ;
    skos:broader la:Eigenvector ;
    skos:definition "A nonzero vector x in Cn with Ax = λx for a complex eigenvalue λ."@en ;
    skos:prefLabel "complex eigenvector"@en .

la:CoordinateMapping a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:CoordinateSystemsTopic ;
    edu:notation "x ↦ [x]_B" ;
    edu:requires la:CoordinateVector,
        la:Transformation ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 4.4, p. 218" ;
    skos:definition "The mapping x -> [x]B from V to Rn determined by a basis B."@en ;
    skos:prefLabel "coordinate mapping"@en .

la:CramersRule a edu:Theorem,
        owl:NamedIndividual ;
    edu:belongsToTopic la:CramersRuleVolumeAndLinearTransformationsTopic ;
    edu:requires la:Determinant,
        la:InvertibleMatrix,
        la:MatrixEquation ;
    edu:uses la:Determinant,
        la:InvertibleMatrix,
        la:MatrixEquation ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 3.3, p. 179" ;
    skos:definition "For invertible A, the unique solution of Ax = b has entries xi = det Ai(b) / det A."@en ;
    skos:editorialNote "Formulated as a theorem (Theorem 7) in [Lay 2016], so classified as edu:Theorem."@en ;
    skos:prefLabel "Cramer's Rule"@en .

la:DiagonalMatrixRepresentation a edu:Theorem,
        owl:NamedIndividual ;
    edu:belongsToTopic la:EigenvectorsAndLinearTransformationsTopic ;
    edu:requires la:DiagonalizableMatrix,
        la:MatrixOfTransformationRelativeToBases ;
    edu:uses la:DiagonalMatrix,
        la:DiagonalizableMatrix,
        la:MatrixOfTransformationRelativeToBases ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 5.4, p. 293" ;
    skos:definition "If A = PDP⁻¹ with D diagonal and B is the basis of columns of P, then D is the B-matrix of x -> Ax."@en ;
    skos:prefLabel "Diagonal Matrix Representation"@en .

la:Diagonalization a edu:Method,
        owl:NamedIndividual ;
    edu:belongsToTopic la:DiagonalizationTopic ;
    edu:requires la:CharacteristicEquation,
        la:DiagonalizationTheorem,
        la:Eigenspace ;
    edu:uses la:CharacteristicEquation,
        la:DiagonalizableMatrix,
        la:Eigenspace ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 5.3, p. 285" ;
    skos:definition "Find the eigenvalues, a basis of each eigenspace, construct P from the eigenvectors and D from the eigenvalues, and check A = PDP⁻¹."@en ;
    skos:hiddenLabel "diagonalizing matrices"@en ;
    skos:prefLabel "diagonalization of a matrix"@en .

la:ElementaryMatrix a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:TheInverseOfAMatrixTopic ;
    edu:requires la:ElementaryRowOperation,
        la:IdentityMatrix ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 2.2, p. 108" ;
    skos:broader la:SquareMatrix ;
    skos:definition "A matrix obtained by performing a single elementary row operation on an identity matrix."@en ;
    skos:prefLabel "elementary matrix"@en .

la:ExistenceAndUniquenessTheorem a edu:Theorem,
        owl:NamedIndividual ;
    edu:belongsToTopic la:RowReductionAndEchelonFormsTopic ;
    edu:requires la:ConsistentSystem,
        la:FreeVariable ;
    edu:uses la:AugmentedMatrix,
        la:ConsistentSystem,
        la:FreeVariable,
        la:PivotColumn ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 1.2, p. 21" ;
    skos:definition "A linear system is consistent iff the last column of its augmented matrix is not a pivot column; a consistent system has a unique solution iff it has no free variables."@en ;
    skos:prefLabel "Existence and Uniqueness Theorem"@en .

la:FiniteDimensionalSpace a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:TheDimensionOfAVectorSpaceTopic ;
    edu:requires la:SpanningSet ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 4.5, p. 228" ;
    skos:altLabel "finite-dimensional space"@en ;
    skos:broader la:VectorSpace ;
    skos:definition "A vector space spanned by a finite set; otherwise the space is infinite-dimensional."@en ;
    skos:hiddenLabel "finite-dimensional"@en ;
    skos:prefLabel "finite-dimensional vector space"@en .

la:InverseAlgorithm a edu:Method,
        owl:NamedIndividual ;
    edu:belongsToTopic la:TheInverseOfAMatrixTopic ;
    edu:requires la:InverseOfMatrix,
        la:RowReductionAlgorithm ;
    edu:uses la:AugmentedMatrix,
        la:IdentityMatrix,
        la:InverseOfMatrix,
        la:RowEquivalence ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 2.2, p. 110" ;
    skos:definition "Row reduce the augmented matrix [A I]; if A is row equivalent to I, then [A I] becomes [I A⁻¹]."@en ;
    skos:hiddenLabel "algorithm for finding A-1"@en,
        "algorithm for finding A⁻¹"@en ;
    skos:prefLabel "algorithm for finding the inverse of a matrix"@en .

la:InverseFormula a edu:Theorem,
        owl:NamedIndividual ;
    edu:belongsToTopic la:CramersRuleVolumeAndLinearTransformationsTopic ;
    edu:requires la:Adjugate,
        la:InverseOfMatrix ;
    edu:uses la:Adjugate,
        la:Determinant,
        la:InverseOfMatrix ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 3.3, p. 181" ;
    skos:definition "For an invertible matrix A, A⁻¹ = (1 / det A) adj A."@en ;
    skos:editorialNote "Named 'An Inverse Formula' (Theorem 8) in [Lay 2016]."@en ;
    skos:prefLabel "inverse formula"@en .

la:InvertibleMatrixTheorem a edu:Theorem,
        owl:NamedIndividual ;
    edu:belongsToTopic la:CharacterizationsOfInvertibleMatricesTopic ;
    edu:requires la:InvertibleMatrix,
        la:LinearIndependence,
        la:OneToOneMapping,
        la:OntoMapping,
        la:PivotPosition,
        la:Span,
        la:Transpose ;
    edu:uses la:InvertibleMatrix,
        la:LinearIndependence,
        la:OneToOneMapping,
        la:OntoMapping,
        la:PivotPosition,
        la:Span,
        la:Transpose,
        la:TrivialSolution ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 2.3, p. 114" ;
    skos:definition "For a square matrix A the statements 'A is invertible', 'A has n pivot positions', 'Ax = 0 has only the trivial solution', 'the columns of A are linearly independent and span Rn', 'x -> Ax is one-to-one and onto' and others are equivalent."@en ;
    skos:editorialNote "Extended in sections 2.9, 3.2 and 5.2; one element with several mentionedIn links."@en ;
    skos:prefLabel "Invertible Matrix Theorem"@en .

la:Isomorphism a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:CoordinateSystemsTopic ;
    edu:requires la:OneToOneMapping,
        la:OntoMapping,
        la:VectorSpace ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 4.4, p. 222" ;
    skos:broader la:LinearTransformation ;
    skos:definition "A one-to-one linear transformation from a vector space onto another vector space."@en ;
    skos:prefLabel "isomorphism"@en .

la:Kernel a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:NullSpacesColumnSpacesAndLinearTransformationsTopic ;
    edu:notation "ker T" ;
    edu:requires la:LinearTransformation,
        la:VectorSpace ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 4.2, p. 206" ;
    skos:altLabel "kernel"@en,
        "null space of a linear transformation"@en ;
    skos:broader la:Subspace ;
    skos:definition "The set of all u in V with T(u) = 0 for a linear transformation T: V -> W."@en ;
    skos:editorialNote "[Lay 2016] says 'the kernel (or null space) of T'; for matrices only 'null space' is used."@en ;
    skos:prefLabel "kernel of a linear transformation"@en .

la:LUFactorizationAlgorithm a edu:Method,
        owl:NamedIndividual ;
    edu:belongsToTopic la:MatrixFactorizationsTopic ;
    edu:requires la:LUFactorization,
        la:RowReductionAlgorithm ;
    edu:uses la:EchelonForm,
        la:LUFactorization,
        la:MatrixEquation ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 2.5, p. 127" ;
    skos:definition "Reduce A to an echelon form U by row replacements and place the entries of L so that the same operations reduce L to I."@en ;
    skos:prefLabel "LU factorization algorithm"@en .

la:LinearDependenceRelation a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:LinearIndependenceTopic ;
    edu:requires la:LinearDependence ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 1.7, p. 57" ;
    skos:definition "An equation c1v1 + ... + cpvp = 0 with weights not all zero."@en ;
    skos:prefLabel "linear dependence relation"@en .

la:MatrixSum a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:MatrixOperationsTopic ;
    edu:notation "A + B" ;
    edu:requires la:Matrix ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 2.1, p. 95" ;
    skos:definition "The matrix obtained by adding corresponding entries of two matrices of the same size."@en ;
    skos:hiddenLabel "matrix sum"@en ;
    skos:prefLabel "sum of matrices"@en .

la:MultiplicativeProperty a edu:Theorem,
        owl:NamedIndividual ;
    edu:belongsToTopic la:PropertiesOfDeterminantsTopic ;
    edu:requires la:Determinant,
        la:MatrixMultiplication ;
    edu:uses la:Determinant,
        la:MatrixMultiplication ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 3.2, p. 175" ;
    skos:altLabel "multiplicative property"@en ;
    skos:definition "For n x n matrices A and B, det AB = (det A)(det B)."@en ;
    skos:prefLabel "multiplicative property of determinants"@en .

la:Nullity a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:RankTopic ;
    edu:notation "dim Nul A" ;
    edu:requires la:Dimension,
        la:NullSpace ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 4.6, p. 235" ;
    skos:definition "The dimension of the null space of a matrix."@en ;
    skos:prefLabel "nullity"@en .

la:ParametricVectorForm a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:SolutionSetsOfLinearSystemsTopic ;
    edu:requires la:FreeVariable,
        la:LinearCombination ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 1.5, p. 45" ;
    skos:altLabel "parametric vector equation"@en ;
    skos:definition "A description of a solution set as a linear combination of vectors with free variables as parameters."@en ;
    skos:prefLabel "parametric vector form"@en .

la:RankTheorem a edu:Theorem,
        owl:NamedIndividual ;
    edu:belongsToTopic la:DimensionAndRankTopic ;
    edu:requires la:NullSpace,
        la:Rank ;
    edu:uses la:Dimension,
        la:NullSpace,
        la:Rank ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 2.9, p. 158" ;
    skos:definition "If a matrix A has n columns, then rank A + dim Nul A = n."@en ;
    skos:editorialNote "Restated for row spaces in 4.6."@en ;
    skos:prefLabel "Rank Theorem"@en .

la:RowColumnRule a edu:Method,
        owl:NamedIndividual ;
    edu:belongsToTopic la:MatrixOperationsTopic ;
    edu:requires la:MatrixMultiplication ;
    edu:uses la:MatrixMultiplication ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 2.1, p. 98" ;
    skos:definition "The (i, j)-entry of AB is the sum of products of corresponding entries of row i of A and column j of B."@en ;
    skos:prefLabel "row-column rule for computing AB"@en .

la:RowOperationsTheorem a edu:Theorem,
        owl:NamedIndividual ;
    edu:belongsToTopic la:PropertiesOfDeterminantsTopic ;
    edu:requires la:Determinant,
        la:ElementaryRowOperation ;
    edu:uses la:Determinant,
        la:ElementaryRowOperation ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 3.2, p. 171" ;
    skos:altLabel "row operations theorem"@en ;
    skos:definition "Row replacement does not change det A, a row interchange changes its sign, and scaling a row by k multiplies it by k."@en ;
    skos:editorialNote "Named 'Row Operations' (Theorem 3) in [Lay 2016]."@en ;
    skos:prefLabel "row operations theorem for determinants"@en .

la:RowSpace a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:RankTopic ;
    edu:notation "Row A" ;
    edu:requires la:Span ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 4.6, p. 233" ;
    skos:broader la:Subspace ;
    skos:definition "The set of all linear combinations of the rows of a matrix."@en ;
    skos:prefLabel "row space"@en .

la:RowVectorRule a edu:Method,
        owl:NamedIndividual ;
    edu:belongsToTopic la:TheMatrixEquationAxBTopic ;
    edu:requires la:MatrixVectorProduct ;
    edu:uses la:Matrix,
        la:MatrixVectorProduct,
        la:Vector ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 1.4, p. 38" ;
    skos:definition "The i-th entry of Ax is the sum of products of corresponding entries of row i of A and of x."@en ;
    skos:prefLabel "row-vector rule for computing Ax"@en .

la:SingularMatrix a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:TheInverseOfAMatrixTopic ;
    edu:requires la:InvertibleMatrix ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 2.2, p. 105" ;
    skos:broader la:SquareMatrix ;
    skos:definition "A square matrix that is not invertible."@en ;
    skos:prefLabel "singular matrix"@en .

la:SpanningSetTheorem a edu:Theorem,
        owl:NamedIndividual ;
    edu:belongsToTopic la:LinearlyIndependentSetsBasesTopic ;
    edu:requires la:Basis,
        la:SpanningSet ;
    edu:uses la:Basis,
        la:LinearCombination,
        la:SpanningSet ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 4.3, p. 212" ;
    skos:definition "Removing from a spanning set a vector that is a linear combination of the others leaves a spanning set; some subset of a spanning set is a basis."@en ;
    skos:prefLabel "Spanning Set Theorem"@en .

la:StandardBasis a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:SubspacesOfRnTopic ;
    edu:requires la:IdentityMatrix ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 2.8, p. 150" ;
    skos:broader la:Basis ;
    skos:definition "The set of columns e1, ..., en of the n x n identity matrix, a basis of Rn."@en ;
    skos:prefLabel "standard basis"@en .

la:StandardMatrix a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:TheMatrixOfALinearTransformationTopic ;
    edu:requires la:IdentityMatrix,
        la:LinearTransformation,
        la:MatrixTransformation ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 1.9, p. 72" ;
    skos:altLabel "standard matrix"@en ;
    skos:broader la:Matrix ;
    skos:definition "The unique matrix A with T(x) = Ax; its columns are the images of the columns of the identity matrix."@en ;
    skos:prefLabel "standard matrix of a linear transformation"@en .

la:UniqueRepresentationTheorem a edu:Theorem,
        owl:NamedIndividual ;
    edu:belongsToTopic la:CoordinateSystemsTopic ;
    edu:requires la:Basis,
        la:VectorSpace ;
    edu:uses la:Basis,
        la:LinearCombination ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 4.4, p. 218" ;
    skos:definition "For a basis B of V, each x in V can be written in exactly one way as a linear combination of the basis vectors."@en ;
    skos:prefLabel "Unique Representation Theorem"@en .

la:ZeroMatrix a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:MatrixOperationsTopic ;
    edu:notation "0" ;
    edu:requires la:Matrix ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 2.1, p. 94" ;
    skos:definition "A matrix whose entries are all zero."@en ;
    skos:prefLabel "zero matrix"@en .

la:BasicVariable a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:RowReductionAndEchelonFormsTopic ;
    edu:requires la:AugmentedMatrix,
        la:PivotColumn ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 1.2, p. 18" ;
    skos:definition "A variable of a linear system that corresponds to a pivot column of its augmented matrix."@en ;
    skos:hiddenLabel "basic variables"@en ;
    skos:prefLabel "basic variable"@en .

la:ChangeOfBasisTopic a edu:Topic,
        owl:NamedIndividual ;
    edu:order 25 ;
    edu:partOf la:VectorSpacesModule ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 4.7" ;
    skos:prefLabel "Change of Basis"@en .

la:ChangeOfCoordinatesMatrix a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:CoordinateSystemsTopic ;
    edu:notation "P_B" ;
    edu:requires la:CoordinateVector ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 4.4, p. 221" ;
    skos:altLabel "change of basis"@en ;
    skos:broader la:Matrix ;
    skos:definition "A matrix that transforms coordinate vectors relative to one basis into coordinate vectors relative to another basis."@en ;
    skos:editorialNote "The glossary of [Lay 2016] gives 'change of basis: See change-of-coordinates matrix'."@en ;
    skos:prefLabel "change-of-coordinates matrix"@en .

la:CharacteristicPolynomial a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:TheCharacteristicEquationTopic ;
    edu:requires la:CharacteristicEquation ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 5.2, p. 278" ;
    skos:definition "The polynomial det(A − λI) of degree n."@en ;
    skos:prefLabel "characteristic polynomial"@en .

la:CoefficientMatrix a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:SystemsOfLinearEquationsTopic ;
    edu:requires la:SystemOfLinearEquations ;
    dcterms:source "Lay D. C., Lay S. R., McDonald J. J. Linear Algebra and Its Applications. 5th ed. 2016, section 1.1, p. 4" ;
    skos:altLabel "matrix of coefficients"@en ;
    skos:broader la:Matrix ;
    skos:definition "The matrix formed by the coefficients of the variables of a linear system."@en ;
    skos:prefLabel "coefficient matrix"@en .

la:ColumnSpace a edu:Concept,
        owl:NamedIndividual ;
    edu:belongsToTopic la:SubspacesOfRnTopic ;
    edu:notation "Col A" ;
    edu:requires la:Span ;
