@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edu: <http://example.org/edu#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/edu> a owl:Ontology ;
    rdfs:label "Educational course ontology core"@en ;
    owl:versionInfo "1.0" .

edu:belongsToTopic a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "belongs to topic"@en ;
    rdfs:domain edu:KnowledgeElement ;
    rdfs:range edu:Topic .

edu:exampleOf a owl:ObjectProperty ;
    rdfs:label "is example of"@en ;
    rdfs:domain edu:Example ;
    rdfs:range edu:KnowledgeElement .

edu:mentionedIn a owl:ObjectProperty ;
    rdfs:label "mentioned in"@en ;
    rdfs:domain edu:KnowledgeElement ;
    rdfs:range edu:SourceFragment .

edu:notation a owl:DatatypeProperty ;
    rdfs:domain edu:KnowledgeElement ;
    rdfs:range xsd:string .

edu:order a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( edu:Module edu:Topic ) ] ;
    rdfs:range xsd:integer .

edu:partOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "part of"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( edu:Module edu:Topic ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( edu:Course edu:Module ) ] .

edu:prerequisiteOf a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "is prerequisite of"@en ;
    rdfs:domain edu:KnowledgeElement ;
    rdfs:range edu:KnowledgeElement ;
    owl:inverseOf edu:requires .

edu:relatedTo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "related to"@en ;
    rdfs:domain edu:KnowledgeElement ;
    rdfs:range edu:KnowledgeElement .

edu:uses a owl:ObjectProperty ;
    rdfs:label "uses"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( edu:Theorem edu:Method ) ] ;
    rdfs:range edu:Concept .

dcterms:source a owl:AnnotationProperty .

skos:altLabel a owl:AnnotationProperty .

skos:broader a owl:ObjectProperty .

skos:definition a owl:AnnotationProperty .

skos:editorialNote a owl:AnnotationProperty .

skos:hiddenLabel a owl:AnnotationProperty .

skos:prefLabel a owl:AnnotationProperty .

edu:requires a owl:ObjectProperty ;
    rdfs:label "requires"@en ;
    rdfs:domain edu:KnowledgeElement ;
    rdfs:range edu:KnowledgeElement .

edu:Concept a owl:Class ;
    rdfs:label "Concept"@en ;
    rdfs:subClassOf edu:KnowledgeElement ;
    skos:definition "A notion that has a definition in the course."@en .

edu:Course a owl:Class ;
    rdfs:label "Course"@en ;
    skos:definition "A course of study."@en .

edu:Example a owl:Class ;
    rdfs:label "Example"@en ;
    rdfs:subClassOf edu:KnowledgeElement ;
    skos:definition "A worked example; created in the knowledge graph, not in the ontology."@en .

edu:Method a owl:Class ;
    rdfs:label "Method"@en ;
    rdfs:subClassOf edu:KnowledgeElement ;
    skos:definition "A procedure or algorithm."@en .

edu:SourceFragment a owl:Class ;
    rdfs:label "SourceFragment"@en ;
    skos:definition "A fragment of a source document; created by the pipeline."@en .

edu:Theorem a owl:Class ;
    rdfs:label "Theorem"@en ;
    rdfs:subClassOf edu:KnowledgeElement ;
    skos:definition "A proved statement with an established name."@en .

edu:Module a owl:Class ;
    rdfs:label "Module"@en ;
    skos:definition "A chapter (module) of a course."@en .

edu:Topic a owl:Class ;
    rdfs:label "Topic"@en ;
    skos:definition "A topic (section) inside a module."@en .

edu:KnowledgeElement a owl:Class ;
    rdfs:label "KnowledgeElement"@en ;
    skos:definition "Abstract superclass of knowledge elements; not instantiated directly."@en .

[] a owl:AllDisjointClasses ;
    owl:members ( edu:Concept edu:Theorem edu:Method edu:Example ) .

[] a owl:AllDisjointClasses ;
    owl:members ( edu:Course edu:Module edu:Topic edu:KnowledgeElement edu:SourceFragment ) .

